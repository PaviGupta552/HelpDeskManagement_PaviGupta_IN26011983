@model HelpDesk.Mvc.Models.Ticket

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="delete-page">

    <div class="delete-card custom-card">

        <!-- WARNING ICON -->

        <div class="delete-icon">
            🗑
        </div>


        <!-- HEADING -->

        <div class="delete-heading">

            <div class="small-label">
                TICKET MANAGEMENT
            </div>

            <h1>
                Delete this ticket?
            </h1>

            <p>
                You're about to permanently remove this support request.
                This action cannot be undone.
            </p>

        </div>


        <!-- TICKET INFORMATION -->

        <div class="delete-ticket-preview">

            <div class="delete-preview-icon">
                🎫
            </div>

            <div class="delete-preview-content">

                <div class="delete-ticket-number">
                    TICKET #@Model.Id
                </div>

                <div class="delete-ticket-title">
                    @Model.Title
                </div>

                <div class="delete-ticket-meta">

                    <span class="status-badge @GetStatusClass(Model.Status)">
                        @GetStatusIcon(Model.Status)
                        @Model.Status
                    </span>

                    <span class="priority-badge @GetPriorityClass(Model.Priority)">
                        @Model.Priority Priority
                    </span>

                </div>

            </div>

        </div>


        <!-- WARNING -->

        <div class="delete-warning">

            <span class="delete-warning-icon">
                ⚠
            </span>

            <div>

                <strong>
                    This ticket will be permanently deleted.
                </strong>

                <p>
                    All information associated with this ticket will be
                    removed from the system.
                </p>

            </div>

        </div>


        <!-- ACTIONS -->

        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="delete-actions">

                <a asp-controller="Ticket"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="cancel-btn">

                    ← Keep Ticket

                </a>

                <button type="submit"
                        class="delete-confirm-btn">

                    🗑 Yes, Delete Ticket

                </button>

            </div>

        </form>

    </div>

</div>


@functions
{
    string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "open" => "status-open",
            "in progress" => "status-progress",
            "closed" => "status-closed",
            _ => "status-default"
        };
    }

    string GetStatusIcon(string? status)
    {
        return status?.ToLower() switch
        {
            "open" => "●",
            "in progress" => "◐",
            "closed" => "✓",
            _ => "•"
        };
    }

    string GetPriorityClass(string? priority)
    {
        return priority?.ToLower() switch
        {
            "high" => "priority-high",
            "medium" => "priority-medium",
            "low" => "priority-low",
            _ => "priority-default"
        };
    }
}