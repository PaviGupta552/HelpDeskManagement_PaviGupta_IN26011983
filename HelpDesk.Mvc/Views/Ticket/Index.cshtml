@model IEnumerable<HelpDesk.Mvc.Models.Ticket>

@{
    ViewData["Title"] = "Dashboard";

    var tickets = Model?.ToList() ?? new List<HelpDesk.Mvc.Models.Ticket>();

    var totalTickets = tickets.Count;

    var openTickets = tickets.Count(t =>
        string.Equals(t.Status, "Open", StringComparison.OrdinalIgnoreCase));

    var inProgressTickets = tickets.Count(t =>
        string.Equals(t.Status, "In Progress", StringComparison.OrdinalIgnoreCase));

    var closedTickets = tickets.Count(t =>
        string.Equals(t.Status, "Closed", StringComparison.OrdinalIgnoreCase));
}


<!-- =====================================================
     DASHBOARD HEADER
     ===================================================== -->

<div class="dashboard-header">

    <div>
        <div class="small-label">HELP DESK DASHBOARD</div>

        <h1 class="page-title">
            Welcome to Help Desk 👋
        </h1>

        <p class="page-subtitle">
            Manage your support requests and keep everything organised.
        </p>
    </div>

    <div>
        <a asp-controller="Ticket"
           asp-action="Create"
           class="btn-helpdesk">
            ＋ New Ticket
        </a>
    </div>

</div>


<!-- =====================================================
     STAT CARDS
     ===================================================== -->

<div class="row g-4 mb-5">

    <!-- TOTAL -->
    <div class="col-12 col-md-6 col-xl-3">

        <div class="stat-card">

            <div class="stat-icon">
                🎫
            </div>

            <div class="stat-number">
                @totalTickets
            </div>

            <div class="stat-label">
                Total Tickets
            </div>

        </div>

    </div>


    <!-- OPEN -->
    <div class="col-12 col-md-6 col-xl-3">

        <div class="stat-card">

            <div class="stat-icon">
                🟢
            </div>

            <div class="stat-number">
                @openTickets
            </div>

            <div class="stat-label">
                Open Tickets
            </div>

        </div>

    </div>


    <!-- IN PROGRESS -->
    <div class="col-12 col-md-6 col-xl-3">

        <div class="stat-card">

            <div class="stat-icon">
                🔄
            </div>

            <div class="stat-number">
                @inProgressTickets
            </div>

            <div class="stat-label">
                In Progress
            </div>

        </div>

    </div>


    <!-- CLOSED -->
    <div class="col-12 col-md-6 col-xl-3">

        <div class="stat-card">

            <div class="stat-icon">
                ✓
            </div>

            <div class="stat-number">
                @closedTickets
            </div>

            <div class="stat-label">
                Closed Tickets
            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     TICKETS SECTION
     ===================================================== -->

<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        <h2 class="section-title">
            Recent Tickets
        </h2>

        <p class="section-subtitle">
            View and manage your support requests.
        </p>
    </div>

</div>


@if (!tickets.Any())
{
    <!-- EMPTY STATE -->

    <div class="custom-card empty-state">

        <div class="empty-icon">
            🎫
        </div>

        <h3>No tickets yet</h3>

        <p>
            You haven't created any support tickets.
            Create your first ticket to get started.
        </p>

        <a asp-controller="Ticket"
           asp-action="Create"
           class="btn-helpdesk">
            ＋ Create First Ticket
        </a>

    </div>
}
else
{
    <!-- =================================================
         TICKETS TABLE
         ================================================= -->

    <div class="helpdesk-table">

        <div class="table-responsive">

            <table class="table mb-0">

                <thead>

                    <tr>

                        <th>
                            ID
                        </th>

                        <th>
                            Ticket
                        </th>

                        <th>
                            Priority
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Raised By
                        </th>

                        <th>
                            Created
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var ticket in tickets)
                    {
                        <tr>

                            <!-- ID -->
                            <td>
                                <span class="ticket-id">
                                    #@ticket.Id
                                </span>
                            </td>


                            <!-- TITLE -->
                            <td>

                                <div class="ticket-title">
                                    @ticket.Title
                                </div>

                                <div class="ticket-description">

                                    @if (!string.IsNullOrWhiteSpace(ticket.Description))
                                    {
                                        if (ticket.Description.Length > 65)
                                        {
                                            @ticket.Description.Substring(0, 65)
                                            <text>...</text>
                                        }
                                        else
                                        {
                                            @ticket.Description
                                        }
                                    }

                                </div>

                            </td>


                            <!-- PRIORITY -->
                            <td>

                                <span class="priority-badge
                                            @GetPriorityClass(ticket.Priority)">
                                    @ticket.Priority
                                </span>

                            </td>


                            <!-- STATUS -->
                            <td>

                                <span class="status-badge
                                            @GetStatusClass(ticket.Status)">
                                    @GetStatusIcon(ticket.Status)
                                    @ticket.Status
                                </span>

                            </td>


                            <!-- RAISED BY -->
                            <td>

                                <div class="raised-by">
                                    @ticket.RaisedBy
                                </div>

                            </td>


                            <!-- DATE -->
                            <td>

                                <span class="created-date">
                                    @ticket.CreatedDate.ToString("dd MMM yyyy")
                                </span>

                            </td>


                            <!-- ACTIONS -->
                            <td class="text-end">

                                <!-- DETAILS -->
                                <a asp-controller="Ticket"
                                   asp-action="Details"
                                   asp-route-id="@ticket.Id"
                                   class="action-btn"
                                   title="View ticket">
                                    👁
                                </a>


                                <!-- EDIT -->
                                <a asp-controller="Ticket"
                                   asp-action="Edit"
                                   asp-route-id="@ticket.Id"
                                   class="action-btn"
                                   title="Edit ticket">
                                    ✎
                                </a>


                                <!-- DELETE -->
                                <a asp-controller="Ticket"
                                   asp-action="Delete"
                                   asp-route-id="@ticket.Id"
                                   class="action-btn delete-action"
                                   title="Delete ticket">
                                    🗑
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@functions
{
    string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "open" => "status-open",
            "in progress" => "status-progress",
            "closed" => "status-closed",
            _ => "status-default"
        };
    }


    string GetStatusIcon(string? status)
    {
        return status?.ToLower() switch
        {
            "open" => "●",
            "in progress" => "◐",
            "closed" => "✓",
            _ => "•"
        };
    }


    string GetPriorityClass(string? priority)
    {
        return priority?.ToLower() switch
        {
            "high" => "priority-high",
            "medium" => "priority-medium",
            "low" => "priority-low",
            _ => "priority-default"
        };
    }
}